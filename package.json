{
  "name": "gamechanger-mvp",
  "version": "0.1.0",
  "private": true,
  "description": "GameChanger-like baseball scoring and private streaming MVP",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -b && pnpm --filter @gamechanger/mobile build",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b --pretty false && pnpm --filter @gamechanger/mobile typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:api": "pnpm --filter @gamechanger/api dev",
    "dev:realtime": "pnpm --filter @gamechanger/realtime dev",
    "dev:worker": "pnpm --filter @gamechanger/worker dev",
    "dev:mobile": "pnpm --filter @gamechanger/mobile start"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3",
    "ws": "^8.21.3"
  }
}
