# Safe default: does not connect to any external database, Redis, or object storage.
APP_MODE=memory
NODE_ENV=development
LOG_LEVEL=info

API_HOST=127.0.0.1
API_PORT=4100
REALTIME_HOST=127.0.0.1
REALTIME_PORT=4101
API_INTERNAL_URL=http://127.0.0.1:4100
INTERNAL_SERVICE_TOKEN=replace-with-a-long-random-local-secret

# These are deliberately blank until the deployment environment is confirmed.
DATABASE_URL=
REDIS_URL=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

AUTH_PROVIDER=dev
OIDC_ISSUER=
OIDC_AUDIENCE=

VIDEO_PROVIDER=mock
AWS_REGION=
AWS_IVS_CHANNEL_ARN=
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

POLICY_REGION_CODE=UNSET
POLICY_VERSION=draft-local
ACCOUNT_MIN_AGE=
PUBLIC_SHARING_ENABLED=false
ATHLETE_LOGIN_ENABLED=false
GUARDIAN_CONSENT_MODE=pilot-review-required
BASEBALL_RULES_VERSION=draft-0.1
OFFICIAL_STAT_SET_VERSION=draft-unapproved

FREE_VIDEO_QUOTA_MINUTES=
PILOT_MAX_TEAMS=
PILOT_PEAK_CONCURRENT_VIEWERS=
PILOT_TEAM_ID=
PILOT_GAME_ID=

IOS_BUNDLE_ID=
APPLE_TEAM_ID=
IOS_MIN_VERSION=
