{
  "name": "@gamechanger/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "react-native start",
    "ios": "react-native run-ios",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit --pretty false"
  },
  "codegenConfig": {
    "name": "GameChangerNativeSpec",
    "type": "modules",
    "jsSrcsDir": "specs",
    "ios": {
      "modulesProvider": {
        "NativeScoreEventStore": "RCTNativeScoreEventStore",
        "NativeBroadcastSession": "RCTNativeBroadcastSession"
      }
    }
  },
  "dependencies": {
    "@gamechanger/contracts": "workspace:*",
    "@gamechanger/domain": "workspace:*",
    "react": "^19.2.3",
    "react-native": "0.87.0"
  },
  "devDependencies": {
    "@react-native/babel-preset": "0.87.0",
    "@react-native/metro-config": "0.87.0",
    "@types/react": "^19.2.0"
  }
}
